{
  "name": "rypples-platform",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build --turbopack",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "e2e": "playwright test",
    "typecheck": "tsc --noEmit -p .",
    "db:gen": "tsx scripts/gen-migration.ts",
    "db:seed": "tsx scripts/seed.mts",
    "db:reseed": "tsx scripts/seed.mts --reseed",
    "sweep:sessions": "tsx scripts/sweep-sessions.mts",
    "snapshot:sources": "tsx scripts/snapshot-sources.ts",
    "build:geo": "scripts/geo/.venv/bin/python scripts/geo/build_geo.py",
    "precompute": "tsx --conditions=react-server scripts/precompute.ts",
    "evals": "tsx --conditions=react-server scripts/evals.ts",
    "check:models": "tsx --conditions=react-server scripts/check-models.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.12.0",
    "@insforge/sdk": "1.5.2",
    "@modelcontextprotocol/sdk": "1.32.2",
    "clsx": "^2.1.1",
    "d3-geo": "^3.1.2",
    "d3-scale": "^4.0.3",
    "d3-shape": "^3.2.1",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "framer-motion": "14.14.0",
    "ioredis": "^6.0.0",
    "next": "15.5.29",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "server-only": "^0.0.1",
    "topojson-client": "^3.1.0",
    "ulid": "^3.0.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/postcss": "^4",
    "@types/d3-geo": "^3.1.1",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-shape": "^3.2.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-specification": "^1.0.5",
    "@vitest/coverage-v8": "^5.1.1",
    "eslint": "^9",
    "eslint-config-next": "15.5.29",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.1",
    "world-atlas": "^2.0.2"
  },
  "packageManager": "pnpm@11.2.2",
  "engines": {
    "node": ">=20"
  }
}
