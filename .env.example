# ── Claude API ─────────────────────────────────────────────────────────
# Without a key (or with LIVE_AI=off) every flow replays precomputed output.
ANTHROPIC_API_KEY=
LIVE_AI=off
# Model overrides (defaults shown). Never use claude-fable-5-2 for this project.
MODEL_FAST=claude-haiku-5-5
MODEL_MAIN=claude-sonnet-5-5
# Used for the any-company (F2) synthesis call. Set empty to use MODEL_MAIN.
MODEL_DEEP=claude-opus-5-5

# ── InsForge (Postgres system of record) ───────────────────────────────
# Unset → in-memory store (fine for local dev; not for Vercel, where requests don't share memory).
INSFORGE_BASE_URL=
INSFORGE_SERVICE_KEY=

# ── Redis (budget, rate limits, cache) ─────────────────────────────────
# Either REDIS_URL or the Upstash REST pair. Unset → in-process fallback.
REDIS_URL=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Spending caps ──────────────────────────────────────────────────────
AI_DAILY_BUDGET_USD=25
AI_F2_DAILY_RUNS=60
AI_PRIORITY_BUDGET_USD=15

# ── Demo access ────────────────────────────────────────────────────────
# Visiting any URL with ?k=<token> grants the priority cookie (bypasses per-IP limits).
DEMO_PRIORITY_TOKEN=
# Salt for hashing visitor IPs (never stored in plain text).
IP_HASH_SALT=change-me

# ── Scenario ───────────────────────────────────────────────────────────
# Must be a Monday. Day 39 of the first 100 on 2026-11-23.
SCENARIO_DATE=2026-11-23

# ── Public ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
